# CPU-only Dockerfile v3 — diarize + Zipformer (no Pyannote)
FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y ffmpeg && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# Install CPU-only PyTorch + dependencies (including diarize)
RUN pip install --upgrade pip && \
    pip install --no-cache-dir "torch==2.5.1" "torchaudio==2.5.1" --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir -r requirements.txt

COPY . .

RUN mkdir -p /workspace/cache
RUN python builder.py

CMD [ "python", "-u", "handler.py" ]
